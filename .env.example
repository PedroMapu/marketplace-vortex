# Frontend — somente valores públicos podem usar o prefixo VITE_
PORT=3000
VITE_API_URL=http://localhost:3000

# Em produção, informe origens exatas separadas por vírgula (sem caminhos).
# Exemplo: https://marketplace-vortex.vercel.app,https://www.exemplo.com
# Em desenvolvimento, somente localhost, 127.0.0.1 e [::1] são aceitos.
FRONTEND_ORIGINS=

# PostgreSQL/Neon — copie as URLs geradas pelo painel sem remover os parâmetros SSL.
# No desenvolvimento local, use somente as branches development e test.
DATABASE_URL=
DATABASE_URL_DIRECT=
TEST_DATABASE_URL=

# Autenticação — gere um segredo aleatório com pelo menos 32 bytes.
JWT_SECRET=

# Desenvolvimento/testes somente. Nunca habilite em produção.
# Expõe o token de redefinição na resposta para testar o fluxo sem e-mail.
PASSWORD_RESET_EXPOSE_TOKEN=false

# Redefinição de senha — obrigatórias em produção.
# A origem deve ser a URL pública do frontend, sem caminho no final.
PASSWORD_RESET_FRONTEND_ORIGIN=http://localhost:5173
PASSWORD_RESET_FROM_EMAIL=Marketplace Vortex <contato@seu-dominio-verificado.com>
RESEND_API_KEY=

# Nunca use VITE_ em variáveis de banco/autenticação nem compartilhe estes valores.
