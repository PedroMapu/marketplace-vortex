  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PedroMapu/marketplace-vortex/issues"
  },
  "homepage": "https://github.com/PedroMapu/marketplace-vortex#readme",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
