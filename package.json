{
  "name": "marketplace-vortex",
  "version": "1.0.0",
  "description": "Aplicação Full Stack para cadastro, listagem, filtro e exclusão de anúncios de produtos destinados à reutilização, venda ou doação.",
  "main": "server.js",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch server.js",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test",
    "regression:published": "node scripts/regression-published.js",
    "migrate": "node scripts/migrate.js",
    "start": "node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroMapu/marketplace-vortex.git"
  },
  "keywords": [],
  "author": "",
